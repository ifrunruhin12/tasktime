# Database Configuration
# For local development (PostgreSQL)
DATABASE_URL=postgres://tasktime:tasktime@localhost:5432/tasktime?sslmode=disable

# For production with Neon (preferred)
NEON_DATABASE_URL=postgres://username:password@ep-xxx-xxx.region.aws.neon.tech/dbname?sslmode=require

# Authentication Configuration
# JWT Secret (minimum 32 characters for security)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
# JWT token expiry in days (default: 7)
JWT_EXPIRY_DAYS=7

# Server Configuration
# Port to run the server on (default: 8080)
TASKTIME_PORT=8080
# Host to bind to (default: 0.0.0.0)
TASKTIME_HOST=0.0.0.0

# Logging Configuration
# Log level: debug, info, warn, error (default: info)
LOG_LEVEL=info
# Log file path (optional, logs to stdout if not set)
LOG_FILE=/var/log/tasktime/server.log

# WebSocket Configuration
# Ping interval for WebSocket connections (default: 30s)
WS_PING_INTERVAL=30s
# Pong timeout for WebSocket connections (default: 60s)
WS_PONG_TIMEOUT=60s

# For production, use a strong random secret:
# JWT_SECRET=$(openssl rand -base64 32)

# Example production configuration:
# NEON_DATABASE_URL=postgres://user:pass@ep-xxx-xxx.us-east-1.aws.neon.tech/tasktime?sslmode=require
# JWT_SECRET=AbCdEfGhIjKlMnOpQrStUvWxYz1234567890
# TASKTIME_PORT=8080
# LOG_LEVEL=info
# LOG_FILE=/var/log/tasktime/server.log
