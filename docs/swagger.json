                    {
                        "description": "Assignment details (null to unassign)",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/github_com_ifrunruhin12_tasktime_internal_models.AssignTaskRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/github_com_ifrunruhin12_tasktime_internal_models.Task"
                        }
                    },
                    "400": {
                        "description": "Invalid request or user not online",
                        "schema": {
                            "$ref": "#/definitions/internal_server.ErrorResponse"
